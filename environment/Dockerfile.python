# syntax=docker/dockerfile:1
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime-base
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates git time libgomp1 libglib2.0-0 \
    && mkdir -p /opt/image

FROM runtime-base AS dependencies
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends build-essential
COPY builder-requirements.txt /opt/builder-requirements.txt
RUN python -m venv /opt/build && /opt/build/bin/pip install --no-cache-dir -r /opt/builder-requirements.txt
COPY --chmod=0755 git-askpass.sh /opt/git-askpass.sh
ARG STAGE_DIR
COPY stages/${STAGE_DIR}/requirements.lock /opt/requirements.lock
COPY stages/${STAGE_DIR}/build.constraints /opt/build.constraints
COPY fetch_sources.py /opt/fetch_sources.py
RUN --mount=type=secret,id=github_token \
    GIT_ASKPASS=/opt/git-askpass.sh GIT_TERMINAL_PROMPT=0 \
    /opt/build/bin/python /opt/fetch_sources.py \
    --requirements /opt/requirements.lock \
    --directory /sources \
    --output /opt/requirements.local.lock
RUN /opt/build/bin/pip wheel --no-cache-dir --no-deps --build-constraint /opt/build.constraints \
    -r /opt/requirements.local.lock -w /wheels

FROM dependencies AS library
COPY build-library.py fetch_library.py /opt/
COPY stages/${STAGE_DIR}/source.json /opt/image/source.json
RUN --mount=type=secret,id=github_token \
    GIT_ASKPASS=/opt/git-askpass.sh GIT_TERMINAL_PROMPT=0 \
    /opt/build/bin/python /opt/fetch_library.py \
    --source-json /opt/image/source.json \
    --directory /library-source
RUN /opt/build/bin/python /opt/build-library.py --source /library-source

FROM runtime-base AS runtime
COPY runtime-check.py /opt/image/runtime-check.py
RUN --mount=type=bind,from=dependencies,source=/wheels,target=/wheels \
    python -m pip install --no-cache-dir --no-index --no-deps /wheels/*.whl
COPY --from=library /opt/image/source.json /opt/image/source.json
COPY --from=library /opt/image/library-wheel.json /opt/image/library-wheel.json
RUN --mount=type=bind,from=library,source=/library,target=/library \
    python -m pip install --no-cache-dir --no-index --no-deps /library/*.whl \
    && python -m pip check \
    && mkdir -p /data /results /scratch \
    && python /opt/image/runtime-check.py \
    && python -m pip list --format=json > /opt/image/packages.json \
    && rm -rf /data /results /scratch
CMD ["bash"]
