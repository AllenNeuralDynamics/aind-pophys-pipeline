params.backend = 'codeocean'

process {
    executor = 'awsbatch'
    queueSize = 100
    maxForks = 16          
    errorStrategy = 'retry'       
    maxRetries = 1
    maxErrors = 100
    time = 1.d

    withName: ghcr_pull_smoke {
        cpus = 1
        memory = '1 GB'
        time = '10m'
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: gpu_smoke {
        cpus = 16
        memory = '60 GB'
        accelerator = 1
        label = 'gpu'
        containerOptions = '--shm-size 4g'
        time = '15m'
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: converter_capsule {
        cpus = 16
        memory = '128 GB'
    }
    withName: motion_correction {
        cpus = 16
        memory = '128 GB'
    }
    withName: movie_qc {
        cpus = 16
        memory = '128 GB'
    }
    withName: decrosstalk_split_json {
        cpus = 2
        memory = '16 GB'
    }
    withName: decrosstalk_roi_images {
        cpus = 8
        memory = '64 GB'
    }
    withName: extraction {
        cpus = 8
        memory = '64 GB'
    }
    withName: dff_capsule {
        cpus = 4
        memory = '32 GB'
    }
    withName: oasis_event_detection {
        cpus = 4
        memory = '32 GB'
    }
    withName: classifier {
        cpus = 16
        memory = '60 GB'
        accelerator = 1
        label = 'gpu'
        containerOptions = '--shm-size 4g'
    }
    withName: ophys_nwb {
        cpus = 4
        memory = '32 GB'
    }
    withName: pipeline_processing_metadata_aggregator {
        cpus = 2
        memory = '16 GB'
    }
}
process.resourceLabels = ['allen-batch-pipeline': 'aind-pophys-pipeline']
env {
    PIPELINE_NAME = "aind-pophys-pipeline"
    PIPELINE_VERSION = "2.0.0"
    PIPELINE_URL = "https://github.com/AllenNeuralDynamics/aind-pophys-pipeline"
}
