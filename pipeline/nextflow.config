process {
    executor = 'awsbatch'
    maxForks = 16
    errorStrategy = 'retry'
    maxRetries = 20
    maxErrors = 100
    time = 1.d
}
executor {
    queueSize = 100
}
process.resourceLabels = ['allen-batch-pipeline': 'aind-pophys-pipeline']
process {
  withName: classifier { containerOptions = '--shm-size 4g' }
}

env {
    PIPELINE_NAME = "aind-pophys-pipeline"
    PIPELINE_VERSION = "1.0.1"
    PIPELINE_URL = "https://github.com/AllenNeuralDynamics/aind-pophys-pipeline"
}

// Code Ocean-injected env vars; on HPC they're unset and the hpc profile
// overrides per-process containers, so empty fallbacks are fine.
params.REGISTRY_HOST = System.getenv('REGISTRY_HOST') ?: ''
params.RESULTS_PATH  = System.getenv('RESULTS_PATH')  ?: 'results'

profiles {
    // Default (no -profile): AWS Batch via Code Ocean, configured by the `process` blocks above.

    // Local / HPC execution. Run with:
    //   nextflow run pipeline/main.nf -profile local --local_session_dir <session-folder-name>
    // The session must be pre-mounted under the pipeline's data/ directory.
    local {
        process {
            executor = 'local'
            errorStrategy = 'terminate'
            resourceLabels = [:]
            maxForks = 4   // tune to the host; the awsbatch default of 16 is too high for one machine

            // Per-process container overrides for off-Code-Ocean execution.
            // Capsule code is baked into each image at /capsule/code; the process script
            // copies from there when GIT_ACCESS_TOKEN is unset (HPC/local path).
            // converter_capsule and decrosstalk_* still reference the Code Ocean
            // registry and will fail under this profile until images exist.
            withName: motion_correction { container = 'ghcr.io/allenneuraldynamics/motion-correction:v5' }
            withName: movie_qc { container = 'ghcr.io/allenneuraldynamics/ophys-movie-qc:v4' }
            withName: extraction { container = 'ghcr.io/allenneuraldynamics/ophys-extraction:v4' }
            withName: classifier { container = 'ghcr.io/allenneuraldynamics/ophys-roicat-classifier:v4' }
            withName: dff_capsule { container = 'ghcr.io/allenneuraldynamics/quophys-dff:v4' }
            withName: oasis_event_detection { container = 'ghcr.io/allenneuraldynamics/phoasis-event-detection:v4' }
            withName: ophys_nwb { container = 'ghcr.io/allenneuraldynamics/ophys-nwb-packaging:v4' }
            withName: pipeline_processing_metadata_aggregator { container = 'ghcr.io/allenneuraldynamics/pmetadata-manager:v4' }
            withName: quality_control_aggregator { container = 'ghcr.io/allenneuraldynamics/ophys-quality-control-aggregator:v4' }
        }
        // The Code Ocean Docker registry ($REGISTRY_HOST) is not reachable off-platform.
        // Enable Singularity/Apptainer and repoint each process `container` at a resolvable image
        // before this profile can actually execute the capsules.
        singularity {
            enabled = true
            autoMounts = true
        }
    }

    // Slurm + Singularity execution on HPC. Run with:
    //   nextflow run pipeline/main.nf -profile hpc \
    //     --local_session_dir <session-folder-name> \
    //     --capsule_code_dir /allen/aind/scratch/ariellel/capsules \
    //     --slurm_partition <partition> --slurm_account <account>
    //
    // Per-process container overrides repoint just the HPC-portable capsules to GHCR;
    // CO-only capsules still reference $REGISTRY_HOST and will fail under this profile
    // until they are also published. Spike scope: motion_correction only.
    hpc {
        params {
            slurm_partition = 'aind'
            slurm_account = ''
            // Pre-cloned capsule code lives here; processes copy from
            // ${capsule_code_dir}/<repo-name>/code instead of git-cloning at runtime.
            capsule_code_dir = ''
        }
        process {
            executor = 'slurm'
            errorStrategy = 'retry'
            maxRetries = 2
            resourceLabels = [:]
            queue = "${params.slurm_partition}"
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
            // Module names are cluster-specific; discover with `module avail` and replace.
            beforeScript = 'module load nextflow singularity || true'

            // Each process below bakes its capsule code into the image at /capsule/code.
            // The script bodies in main.nf detect Singularity via $SINGULARITY_NAME and copy
            // /capsule/code into the workdir instead of git-cloning. The beforeScript
            // pre-creates the bind-target dirs in the host workdir; Singularity needs them
            // to exist before launch.
            // converter_capsule and decrosstalk_* still reference the Code Ocean
            // registry and will fail under this profile until images exist.
            withName: motion_correction {
                container = 'ghcr.io/allenneuraldynamics/motion-correction:v5'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: movie_qc {
                container = 'ghcr.io/allenneuraldynamics/ophys-movie-qc:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/data/raw capsule/data/zstacks capsule/results capsule/scratch'
            }
            withName: extraction {
                container = 'ghcr.io/allenneuraldynamics/ophys-extraction:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: classifier {
                // --shm-size from the top-level `process` block is Docker-only and is
                // overridden here; Singularity uses the dynamic binds set in main.nf.
                container = 'ghcr.io/allenneuraldynamics/ophys-roicat-classifier:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: dff_capsule {
                container = 'ghcr.io/allenneuraldynamics/quophys-dff:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: oasis_event_detection {
                container = 'ghcr.io/allenneuraldynamics/phoasis-event-detection:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: ophys_nwb {
                container = 'ghcr.io/allenneuraldynamics/ophys-nwb-packaging:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/data/schemas capsule/data/raw capsule/data/raw/behavior capsule/data/nwb capsule/data/processed capsule/results capsule/scratch'
            }
            withName: pipeline_processing_metadata_aggregator {
                container = 'ghcr.io/allenneuraldynamics/pmetadata-manager:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
            withName: quality_control_aggregator {
                container = 'ghcr.io/allenneuraldynamics/ophys-quality-control-aggregator:v4'
                beforeScript = 'module load nextflow singularity || true; mkdir -p capsule/data capsule/results capsule/scratch'
            }
        }
        // Forward GHCR credentials to worker SLURM jobs so singularity pull can authenticate.
        // Set SINGULARITY_DOCKER_USERNAME / SINGULARITY_DOCKER_PASSWORD in the submitting shell.
        env {
            SINGULARITY_DOCKER_USERNAME = System.getenv('SINGULARITY_DOCKER_USERNAME') ?: ''
            SINGULARITY_DOCKER_PASSWORD = System.getenv('SINGULARITY_DOCKER_PASSWORD') ?: ''
        }
        singularity {
            enabled = true
            autoMounts = true
        }
    }
}
