nextflow.enable.strict = false

params.backend = 'local'
params.executor = 'local'
def data_path = System.getenv('DATA_PATH') ?: "${baseDir}/../data"

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxForks = 4
    cpus = 8
    memory = '32 GB'

    withName: ghcr_pull_smoke {
        cpus = 1
        memory = '1 GB'
        time = '10m'
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: converter_capsule {
        cpus = 16
        memory = '128 GB'
    }
    withName: motion_correction {
        cpus = 16
        memory = '128 GB'
    }
    withName: movie_qc {
        cpus = 16
        memory = '128 GB'
    }
    withName: decrosstalk_split_json {
        cpus = 2
        memory = '16 GB'
    }
    withName: decrosstalk_roi_images {
        cpus = 8
        memory = '64 GB'
    }
    withName: extraction {
        cpus = 8
        memory = '64 GB'
    }
    withName: dff_capsule {
        cpus = 4
        memory = '32 GB'
    }
    withName: oasis_event_detection {
        cpus = 4
        memory = '32 GB'
    }
    withName: classifier {
        cpus = 16
        memory = '60 GB'
        containerOptions = '--gpus all --shm-size 4g'
    }
    withName: ophys_nwb {
        cpus = 4
        memory = '32 GB'
    }
    withName: pipeline_processing_metadata_aggregator {
        cpus = 2
        memory = '16 GB'
    }
}

docker {
    enabled = true
    runOptions = "--platform=linux/amd64 --volume ${data_path}:/tmp/data"
}

dag {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/dag.html'
    overwrite = true
}

report {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = env('RESULTS_PATH') + '/nextflow/trace.txt'
    overwrite = true
}
